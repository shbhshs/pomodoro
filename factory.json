{
  "image": "node:22-bookworm",
  "install": "npm ci --no-audit --no-fund",
  "check": "npm run check",
  "tools": [
    "Bash(npm run typecheck)",
    "Bash(npm run lint)",
    "Bash(npm test:*)",
    "Bash(npx jest:*)",
    "Bash(npx expo install:*)"
  ],
  "roles": {
    "coder": {
      "runner": "claude-code",
      "model": "claude-sonnet-5-5"
    },
    "reviewer": {
      "runner": "claude-code",
      "model": "claude-opus-5-5"
    }
  }
}
